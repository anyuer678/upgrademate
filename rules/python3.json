    "id": "py3.print_stmt",
    "profile": "python3",
    "priority": "medium",
    "match": {"file": "*.py", "regex": "^(\\s*)print\\s+(?!\\()(.+)$"},
    "replace": "\\1print(\\2)",
    "explain": "Python 3 中 print 为函数，print 语句需加括号",
    "example_before": "print \"hello\"",
    "example_after": "print(\"hello\")"
  },
